#!/bin/busybox sh
# hebi-shell — 合璧OS 文本桌面启动器 (TTY4)
while true; do
    clear
    cat <<'EOF'
   ╔══════════════════════════════════════════╗
   ║        合璧OS HeBi OS 5.0 LTS            ║
   ║      融 Linux 内核，承 Windows 体验       ║
   ╚══════════════════════════════════════════╝
EOF
    echo
    echo "  1) 启动 合璧桌面 Shell (Web 桌面环境)"
    echo "  2) 打开 合璧应用商店 (后台: 8000 端口)"
    echo "  3) 办公助手 / 语音助手"
    echo "  4) 系统信息 (neofetch)"
    echo "  5) 关机 / 重启"
    echo
    printf "  请选择 [1-5]: "
    read c
    case "$c" in
        1) echo "hebi-shell: 真实硬件上由 /usr/bin/hebi-desktop 启动 Web 桌面"; /bin/busybox sleep 1 ;;
        2) echo "hebi-store: 应用商店后台 http://localhost:8000"; /bin/busybox sleep 1 ;;
        3) echo "hebi-office / hebi-voice: 内置办公助手与语音助手"; /bin/busybox sleep 1 ;;
        4) neofetch 2>/dev/null || cat /etc/os-release ;;
        5) poweroff -f 2>/dev/null || echo o > /proc/sysrq-trigger ;;
        *) ;;
    esac
done
